# Include inside your HTTPS server block. Define $boost_custom_rpc_token in a
# restricted server-only include using the content of BOOST_RPC_TOKEN_FILE.
# Never share that RPC token with bridge clients; they use their HMAC secret.
location ^~ /boost-bot/amb/hooks/custom/ {
    limit_except POST { deny all; }
    client_max_body_size 1m;
    proxy_pass http://boost_service;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_set_header Cookie "";
    proxy_set_header Authorization "";
    proxy_set_header X-Boost-Rpc-Token $boost_custom_rpc_token;
    proxy_set_header X-Boost-Rpc-Actor-Role system_admin;
    proxy_set_header X-Boost-Rpc-Actor-User-Id "";
    proxy_set_header X-Boost-Hook-Timestamp $http_x_boost_hook_timestamp;
    proxy_set_header X-Boost-Hook-Signature $http_x_boost_hook_signature;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}
