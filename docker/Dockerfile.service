FROM node:24-bookworm-slim AS bot
WORKDIR /src
COPY bot ./bot
COPY scripts/prepare-boost-bot.mjs ./scripts/prepare-boost-bot.mjs
RUN node scripts/prepare-boost-bot.mjs && cd bot && npm prune --omit=dev --no-audit --no-fund

FROM rust:1-bookworm AS builder

WORKDIR /src

# 先拷贝 manifests，尽量利用 Docker layer cache
COPY Cargo.toml Cargo.lock ./
COPY backend ./backend

RUN cargo build --locked -p boost-service --release

FROM debian:bookworm-slim

ARG APP_USER=boost
ARG APP_UID=10001

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid ${APP_UID} ${APP_USER} \
    && useradd --system --uid ${APP_UID} --gid ${APP_UID} --home-dir /app --create-home --shell /usr/sbin/nologin ${APP_USER} \
    && mkdir -p /data \
    && chown -R ${APP_UID}:${APP_UID} /app /data

COPY --from=builder /src/target/release/boost-service /usr/local/bin/boost-service
COPY --from=bot /src/bot /usr/local/bin/boost-bot

ENV BOOST_SERVICE_ADDR=0.0.0.0:12580
ENV BOOST_DB_PATH=/data/boost.db
ENV BOOST_RPC_TOKEN_FILE=/data/boost.rpc-token
ENV BOOST_GATEWAY_TRACE_STDOUT=1
ENV BOOST_GATEWAY_ERROR_STDOUT=1

VOLUME ["/data"]
EXPOSE 12580

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:12580/health || exit 1

USER ${APP_USER}

CMD ["boost-service"]
