FROM node:22-bookworm-slim AS ui

WORKDIR /src/frontend

RUN corepack enable && corepack prepare pnpm@10.30.3 --activate

COPY frontend/package.json frontend/pnpm-lock.yaml frontend/tsconfig.json frontend/vite.config.ts frontend/index.html frontend/boost-theme.js ./
COPY frontend/src ./src
COPY assets /src/assets
COPY bot/shared /src/bot/shared

RUN pnpm install --frozen-lockfile && pnpm run build

FROM rust:1-bookworm AS builder

WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY backend ./backend

COPY --from=ui /src/frontend/out ./frontend/out

RUN cargo build --locked -p boost-web --release --features embedded-ui

FROM debian:bookworm-slim

ARG APP_USER=boost
ARG APP_UID=10001

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid ${APP_UID} ${APP_USER} \
    && useradd --system --uid ${APP_UID} --gid ${APP_UID} --home-dir /app --create-home --shell /usr/sbin/nologin ${APP_USER} \
    && mkdir -p /data \
    && chown -R ${APP_UID}:${APP_UID} /app /data

COPY --from=builder /src/target/release/boost-web /usr/local/bin/boost-web

ENV BOOST_WEB_ADDR=0.0.0.0:12580
ENV BOOST_WEB_NO_SPAWN_SERVICE=1
ENV BOOST_WEB_NO_OPEN=1
# 默认值适配 docker-compose 的服务名；单独运行时可覆盖为外部 service 的地址。
ENV BOOST_SERVICE_ADDR=boost-service:48760
ENV BOOST_DB_PATH=/data/boost.db
ENV BOOST_RPC_TOKEN_FILE=/data/boost.rpc-token

VOLUME ["/data"]
EXPOSE 12580

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:12580/__auth_status || exit 1

USER ${APP_USER}

CMD ["boost-web"]
