FROM python:3.13-slim
WORKDIR /app
COPY bot/backend/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY bot/backend/api ./bot/backend/api
ENV BOT_API_UPSTREAM=http://boost-web:12000
ENV PYTHONDONTWRITEBYTECODE=1
USER 10001:10001
EXPOSE 12001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:12001/healthz', timeout=3)"
CMD ["uvicorn", "bot.backend.api.app:app", "--host", "0.0.0.0", "--port", "12001", "--workers", "2", "--no-access-log", "--timeout-keep-alive", "65"]
