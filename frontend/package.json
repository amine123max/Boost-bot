{
  "name": "boost-frontend",
  "version": "0.5.1",
  "packageManager": "pnpm@10.30.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3005",
    "dev:full": "node ../scripts/dev-boost.mjs",
    "dev:desktop": "vite --host 127.0.0.1 --port 3005 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "build:desktop": "pnpm run build",
    "start": "vite preview --host 127.0.0.1 --port 3005"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.2",
    "flag-icons": "^7.6.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.4"
  }
}
