{
  "name": "boost-bot-runtime",
  "productName": "Boost",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:backend": "tsc -p backend/tsconfig.json",
    "start": "node dist/backend/src/boost-host.js",
    "prepare:tools": "node ../scripts/prepare-boost-bot.mjs",
    "bot": "tsx backend/src/cli/amb-bot.ts",
    "build:ui": "vue-tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "fflate": "0.8.2",
    "htm": "^3.1.1",
    "preact": "^11.0.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "unpdf": "1.4.0",
    "vue": "3.5.24",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "6.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.2.2",
    "vue-tsc": "3.1.4"
  }
}
