# Boost runtime example / Boost 运行环境示例
# Copy selected entries beside the executable as boost.env.
# 将需要的条目放在实际可执行文件旁的 boost.env；不要提交凭据。
# Existing process variables take precedence / 已有进程环境变量优先。

# Explicit local listeners / 显式本机监听
BOOST_SERVICE_ADDR=127.0.0.1:12580
BOOST_WEB_ADDR=127.0.0.1:12000

# Optional storage overrides, executable-relative / 可选存储覆盖，相对程序目录
# BOOST_DB_PATH=data/boost.db
# BOOST_RPC_TOKEN_FILE=data/boost.rpc-token

# Optional encrypted storage. Use the same private key file for Service and Web.
# 可选加密存储：Service/Web 使用同一私有密钥文件，不提交真实密钥。
# BOOST_DB_KEY_FILE=data/main-db.key
# Desktop system credential provider / 桌面系统凭据库
# BOOST_DB_ENCRYPTION=keyring

# Internal credential: leave unset for managed generation. DO NOT COMMIT.
# 内部凭据默认由程序管理；显式设置时勿提交真实值。
# BOOST_RPC_TOKEN=

# Storage connection pool / 存储连接池
BOOST_STORAGE_MAX_CONNECTIONS=32
BOOST_STORAGE_MAX_IDLE_CONNECTIONS=16
BOOST_STORAGE_ACQUIRE_TIMEOUT_MS=30000

# Disable automatic browser opening for headless service / 无界面服务不自动打开浏览器
BOOST_WEB_NO_OPEN=1

# Optional FastAPI process environment; not read by Rust / 可选 Python 进程环境
# BOT_API_UPSTREAM=http://127.0.0.1:12000
# BOT_API_CONCURRENCY=256
# BOT_API_QUEUE_SIZE=512
# BOT_API_QUEUE_TIMEOUT=15
# BOT_API_MAX_BODY_BYTES=33554432
# BOT_API_BODY_BUDGET_BYTES=67108864
